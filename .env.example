# Copy to .env and fill in your own URLs and keys. Never commit .env.

# Port the app is published on, and the public address printed into QR codes.
# Leave BASE_URL empty and start with "make up": it finds this laptop's Wi-Fi IP on every start.
# In production set it to the real address, for example https://bosho.app
APP_PORT=8081
BASE_URL=

# 1 = create a sample restaurant when the database is empty (owner 01700000000 / demo1234)
DEMO=1

# PostgreSQL on Supabase: project page -> Connect -> "Session pooler" string (works over IPv4).
# Put in your database password and keep sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Dish photos on Backblaze B2: create a private bucket, then an application key with Read and Write on it.
# Endpoint is the host only (no https://), shown on the bucket page.
# S3_REGION is the middle part of the endpoint: s3.<region>.backblazeb2.com
S3_ENDPOINT=s3.<region>.backblazeb2.com
S3_ACCESS_KEY=<keyID>
S3_SECRET_KEY=<applicationKey>
S3_BUCKET=<your-bucket-name>
S3_REGION=<region>
S3_USE_SSL=1

# Redis on Upstash. Use rediss:// (two s): Upstash only accepts TLS. Not used by the app yet.
REDIS_URL=rediss://default:<token>@<name>.upstash.io:6379
