# Copy to .env and fill in your own URLs and keys. Never commit .env.

# Port the app is published on, and the public address printed into QR codes.
# Leave BASE_URL empty and start with "make up": it finds this laptop's Wi-Fi IP on every start.
# In production set it to the real address, for example https://bosho.food
APP_PORT=8081
BASE_URL=

# 1 = create a sample restaurant when the database is empty (owner 01700000000 / demo1234)
DEMO=1

# PostgreSQL on Supabase: project page -> Connect -> "Session pooler" string (works over IPv4).
# Put in your database password and keep sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Dish photos on Backblaze B2: create a private bucket, then an application key with Read and Write on it.
# Endpoint is the host only (no https://), shown on the bucket page.
# S3_REGION is the middle part of the endpoint: s3.<region>.backblazeb2.com
S3_ENDPOINT=s3.<region>.backblazeb2.com
S3_ACCESS_KEY=<keyID>
S3_SECRET_KEY=<applicationKey>
S3_BUCKET=<your-bucket-name>
S3_REGION=<region>
S3_USE_SSL=1

# Redis on Upstash. Use rediss:// (two s): Upstash only accepts TLS. Optional: refreshing screens
# (kitchen, counter, guest cart and orders) skip the database when nothing changed. Leave empty to run without.
REDIS_URL=rediss://default:<token>@<name>.upstash.io:6379

# Email (owner "Forgot password" and email confirmation). With nothing set, emails are printed in the log.
# On Render's free plan (it blocks SMTP) use Brevo: free account at brevo.com, add your Gmail address as a
# sender (Senders, domains & dedicated IPs -> Senders), create an API key (SMTP & API -> API keys).
BREVO_API_KEY=
# On your laptop, Gmail SMTP works too. Gmail: turn on 2-Step Verification on the Google account, then create an app password at
# https://myaccount.google.com/apppasswords and put it in SMTP_PASSWORD (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<you>@gmail.com
SMTP_PASSWORD=<16-letter app password>
# Keep the quotes in this file: make loads it as a shell script, where < and > mean files.
# (On Render's Environment page, type it without quotes.)
EMAIL_FROM="Bosho <you@gmail.com>"
# Later, with your own domain: leave SMTP_HOST empty and use Resend instead.
RESEND_API_KEY=
# 1 = guests can't order until the owner confirms their email (owners can still set up). Off by default.
# Off = no confirmation at all: no link is sent at signup and every owner counts as confirmed.
EMAIL_VERIFY=0

# Key that encrypts the staff passwords the owner can look up: openssl rand -base64 32
# Empty: the app makes one and keeps it in the database. Don't change it later, or saved staff passwords can't be shown.
PASSWORD_KEY=

# 1 only when a reverse proxy sits in front of the app (guest IPs then come from X-Forwarded-For).
TRUST_PROXY=0
